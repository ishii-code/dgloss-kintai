{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @dgloss-kintai/web... build",
  "crons": [
    {
      "path": "/api/cron/overtime-alerts",
      "schedule": "0 10 * * *"
    }
  ]
}
