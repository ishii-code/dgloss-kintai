# 本番デプロイ用の環境変数（実値はコミットしない）。

# Postgres 接続。docker-compose 利用時は web サービスが自動で組み立てるため、
# 単体起動やマネージド DB 利用時にのみ設定する。
DATABASE_URL="postgresql://kintai:kintai@localhost:5432/kintai?schema=public"

# docker-compose の Postgres パスワード（本番は必ず変更）。
POSTGRES_PASSWORD="change-me"

# jinjer 連携（Shadow 突合・移行を有効化する場合のみ・任意）。
# JINJER_BASE_URL="https://api.jinjer.biz"
# JINJER_API_KEY="***"
# JINJER_SECRET_KEY="***"
# JINJER_COMPANY_CODE="***"
