{
  "name": "@dgloss-kintai/jobs",
  "version": "0.0.0",
  "description": "締めバッチ。日次/月次の勤怠集計・締め処理オーケストレーション。",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
