{
  "name": "@dgloss-kintai/api",
  "version": "0.0.0",
  "description": "勤怠 API のサービス層。打刻登録・勤怠照会・締めのユースケースを型安全に提供する。",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dgloss-kintai/contracts": "workspace:*",
    "@dgloss-kintai/core": "workspace:*",
    "@dgloss-kintai/jobs": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
