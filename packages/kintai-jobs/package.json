    "test:watch": "vitest"
  },
  "dependencies": {
    "@dgloss-kintai/contracts": "workspace:*",
    "@dgloss-kintai/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
