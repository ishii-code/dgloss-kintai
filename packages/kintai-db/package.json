{
  "name": "@dgloss-kintai/db",
  "version": "0.0.0",
  "description": "Prisma 永続化層。kintai-api / kintai-jobs の repository port を実装する。",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "prisma"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@dgloss-kintai/contracts": "workspace:*",
    "@dgloss-kintai/core": "workspace:*",
    "@dgloss-kintai/api": "workspace:*",
    "@dgloss-kintai/jobs": "workspace:*",
    "@prisma/client": "^6.3.1"
  },
  "devDependencies": {
    "prisma": "^6.3.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
